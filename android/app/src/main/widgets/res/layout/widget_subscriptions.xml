<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="@drawable/widget_quick_background">
    <LinearLayout android:id="@+id/widget_subscriptions_header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="24dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_subscriptions_title" android:textColor="@color/widget_quick_ink"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_subscriptions_month"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/widget_quick_muted" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_subscriptions_column_name" android:textSize="10sp" android:textColor="@color/widget_quick_muted" />
        <TextView android:layout_width="@dimen/widget_subscriptions_amount_width" android:layout_height="wrap_content"
            android:gravity="end" android:text="@string/widget_subscriptions_column_amount" android:textSize="10sp" android:textColor="@color/widget_quick_muted" />
        <TextView android:layout_width="@dimen/widget_subscriptions_days_width" android:layout_height="wrap_content"
            android:gravity="end" android:text="@string/widget_subscriptions_column_days" android:textSize="10sp" android:textColor="@color/widget_quick_muted" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_subscriptions_rows"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scrollbarStyle="insideOverlay" android:divider="@color/widget_quick_line" android:dividerHeight="1dp" />
        <TextView android:id="@+id/widget_subscriptions_empty"
            android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:text="@string/widget_subscriptions_setup" android:textColor="@color/widget_quick_muted" android:textSize="11sp" />
    </FrameLayout>
</LinearLayout>
