# Build-time dependencies only. Mobile devices never download these headers/tools.
set(_gpu_headers "${CMAKE_CURRENT_BINARY_DIR}/gpu-include")
foreach(_dependency IN ITEMS vulkan_headers vulkan_hpp spirv_headers)
  if(_dependency STREQUAL "vulkan_headers")
    set(_repo Vulkan-Headers)
    set(_revision 73814d006638aa00bd553215b054f0f02e457e22)
  elseif(_dependency STREQUAL "vulkan_hpp")
    set(_repo Vulkan-Hpp)
    set(_revision da4cb2bc27917f3e5ff40346e448f39515248c32)
  else()
    set(_repo SPIRV-Headers)
    set(_revision fbf86836a9b1966586faf7be7bb8a6440e156d62)
  endif()
  set(_source "${CMAKE_CURRENT_LIST_DIR}/../vendor/${_repo}-${_revision}")
  string(TOUPPER "${_dependency}" _dependency_upper)
  if(EXISTS "${_source}/CMakeLists.txt")
    set(FETCHCONTENT_SOURCE_DIR_${_dependency_upper} "${_source}")
  endif()
  FetchContent_Declare(${_dependency}
    URL "https://codeload.github.com/KhronosGroup/${_repo}/zip/${_revision}"
    SOURCE_DIR "${_source}")
  FetchContent_GetProperties(${_dependency})
  if(NOT ${_dependency}_POPULATED)
    FetchContent_Populate(${_dependency})
  endif()
endforeach()
file(COPY "${vulkan_headers_SOURCE_DIR}/include/" DESTINATION "${_gpu_headers}")
file(COPY "${vulkan_hpp_SOURCE_DIR}/vulkan/" DESTINATION "${_gpu_headers}/vulkan")
file(COPY "${spirv_headers_SOURCE_DIR}/include/spirv" DESTINATION "${_gpu_headers}")
set(Vulkan_INCLUDE_DIR "${_gpu_headers}" CACHE PATH "Vulkan headers" FORCE)
find_library(Vulkan_LIBRARY vulkan REQUIRED)

# ggml requires the SPIR-V package even when its headers share the Vulkan include root.
set(SPIRV-Headers_DIR "${CMAKE_CURRENT_BINARY_DIR}/gpu-cmake")
file(MAKE_DIRECTORY "${SPIRV-Headers_DIR}")
file(WRITE "${SPIRV-Headers_DIR}/SPIRV-HeadersConfig.cmake"
  "if(NOT TARGET SPIRV-Headers::SPIRV-Headers)\nadd_library(SPIRV-Headers::SPIRV-Headers INTERFACE IMPORTED)\nset_target_properties(SPIRV-Headers::SPIRV-Headers PROPERTIES INTERFACE_INCLUDE_DIRECTORIES \"${_gpu_headers}\")\nendif()\n")
if(CMAKE_HOST_WIN32)
  set(_ndk_host windows-x86_64)
  set(_exe .exe)
  set(_portable_bin "${CMAKE_CURRENT_LIST_DIR}/../../.tmp/gpu-tools/w64devkit/bin")
  if(EXISTS "${_portable_bin}/gcc.exe")
    set(HOST_C_COMPILER "${_portable_bin}/gcc.exe" CACHE FILEPATH "Host C compiler")
    set(HOST_CXX_COMPILER "${_portable_bin}/g++.exe" CACHE FILEPATH "Host C++ compiler")
    set(GGML_VULKAN_SHADERS_GEN_TOOLCHAIN "${CMAKE_CURRENT_BINARY_DIR}/gpu-host-toolchain.cmake")
    file(TO_CMAKE_PATH "${CMAKE_MAKE_PROGRAM}" _host_ninja)
    file(WRITE "${GGML_VULKAN_SHADERS_GEN_TOOLCHAIN}"
      "set(CMAKE_C_COMPILER \"${HOST_C_COMPILER}\")\nset(CMAKE_CXX_COMPILER \"${HOST_CXX_COMPILER}\")\nset(CMAKE_MAKE_PROGRAM \"${_host_ninja}\" CACHE FILEPATH \"\" FORCE)\nset(CMAKE_C_FLAGS \"-O2\")\nset(CMAKE_CXX_FLAGS \"-O2\")\n")
  endif()
elseif(CMAKE_HOST_APPLE)
  set(_ndk_host darwin-x86_64)
else()
  set(_ndk_host linux-x86_64)
endif()
set(Vulkan_GLSLC_EXECUTABLE "${ANDROID_NDK}/shader-tools/${_ndk_host}/glslc${_exe}"
  CACHE FILEPATH "NDK shader compiler")
